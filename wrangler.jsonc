{
  // Cloudflare Workers (static assets): menyajikan hasil build Vite di dist/.
  // Tidak ada kode server; semua proses tetap di browser pengguna.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fmm27-pge-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
